# Copy this file to .env and fill in your details

# Gmail account that will send the emails
GMAIL_USER=yourname@gmail.com
# 16-character App Password (NOT your normal Gmail password)
# Create one at: https://myaccount.google.com/apppasswords (requires 2-Step Verification)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Your details used in the email template
MY_NAME=Your Name
MY_PHONE=+91 00000 00000
MY_LINKEDIN=https://linkedin.com/in/yourprofile

# Port for the web UI
PORT=3000

# Hunter.io API key for finding recruiter emails (free plan: 50 credits/month)
# Get one at: https://hunter.io/api-keys
HUNTER_API_KEY=

# Optional: Adzuna keys - needed for INDIA-BASED (on-site/hybrid) jobs.
# The free sources above are remote-focused. Free signup, no card:
# https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
