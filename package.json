{
  "name": "recruiter-email-scheduler",
  "version": "1.0.0",
  "description": "Finds jobs worldwide, matches them against your resume skills, looks up recruiter emails, and sends personalized applications on a schedule",
  "main": "server.js",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "job-search",
    "email-scheduler",
    "resume",
    "recruiters",
    "nodemailer",
    "job-board",
    "automation"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "node-schedule": "^2.1.1",
    "nodemailer": "^6.9.14",
    "pdf-parse": "1.1.1"
  }
}
